{% extends 'dashboard.twig' %}

{% block content %}

    {% if is_configured and not data_sharing_allowed %}

        <div class="alert alert-info">
            <strong>{{ 'MistralAI_DataSharingNotAllowedTitle'|translate }}</strong>
            {{ 'MistralAI_DataSharingNotAllowed'|translate }}
            {% if settings_url %}
                <a href="{{ settings_url }}#mistralAiPrivacy">{{ 'MistralAI_DataSharingSettingsLink'|translate }}</a>
            {% else %}
                {{ 'MistralAI_AskAdministrator'|translate }}
            {% endif %}
        </div>

    {% elseif is_configured %}

        <div vue-entry="MistralAI.ChatIndexPage"
             ai-name="mistral-ai"
             ai-label="MistralAI"
             ai-color="#FA500F"
             api-method="MistralAI.getResponse"
             model-notice="{{ model_notice|json_encode|e('html_attr') }}"
        ></div>

    {% else %}

        <div class="alert alert-info">
            <strong>{{ 'MistralAI_PluginNotConfigured'|translate }}</strong>
            {{ 'MistralAI_PluginNotConfiguredDescription'|translate }}
            {% if settings_url %}
                <a href="{{ settings_url }}">{{ 'MistralAI_SystemSettingsLink'|translate }}</a>
            {% endif %}
        </div>

    {% endif %}

{% endblock %}
